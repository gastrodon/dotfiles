#!/usr/bin/env bash
set -euo pipefail

export NIXPKGS_ALLOW_UNFREE=1
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Nix's git+ssh fetcher offers every ssh-agent key; isolate to the primary one.
if [[ -f "$HOME/.ssh/id_ed25519" ]]; then
  eval "$(ssh-agent -s)" >/dev/null
  trap 'ssh-agent -k >/dev/null 2>&1 || true' EXIT
  ssh-add -q "$HOME/.ssh/id_ed25519" >/dev/null 2>&1 || true
fi

usage() {
  cat >&2 <<EOF
Usage: $0 <build|switch> [hostname] [--sdimage|--serve-pxe]

Commands:
  build              Build configuration
  switch             Switch to new configuration + restart i3

Options:
  --sdimage          Build SD card image (rpi* only)
  --serve-pxe        Build + serve netboot (server only; foreground)

Examples:
  $0 build stone
  $0 build rpi4b --sdimage
  $0 build server --serve-pxe
  $0 switch twink
EOF
  exit 1
}

[[ $# -lt 1 ]] && usage

COMMAND="$1"
HOSTNAME="${2:-${NIXOS_HOSTNAME:-$(hostname)}}"
FLAG="${3:-}"

case "$COMMAND" in
  build|switch) ;;
  *) usage ;;
esac

case "$FLAG" in
  --|--sdimage|--serve-pxe|"") ;;
  *) usage ;;
esac

build_config() {
  echo "Building configuration for $HOSTNAME..."
  nixos-rebuild build --flake "$SCRIPT_DIR#$HOSTNAME" --impure
}

switch_config() {
  echo "Switching to configuration for $HOSTNAME..."
  nixos-rebuild switch --flake "$SCRIPT_DIR#$HOSTNAME" --impure
  i3-msg restart 2>/dev/null || true
}

build_sdimage() {
  if [[ "$HOSTNAME" != "rpi2b" && "$HOSTNAME" != "rpi3b-plus" && "$HOSTNAME" != "rpi4b" ]]; then
    echo "Error: --sdimage only supported for rpi2b|rpi3b-plus|rpi4b" >&2
    exit 1
  fi
  echo "Building SD image for $HOSTNAME..."
  nix build "$SCRIPT_DIR#nixosConfigurations.${HOSTNAME}.config.system.build.sdImage" --impure
  echo "SD image at: $(readlink result)/sd-image/"
}

serve_pxe() {
  if [[ "$HOSTNAME" != "server" ]]; then
    echo "Error: --serve-pxe only supported for server" >&2
    exit 1
  fi

  PXE_DIR="${PXE_DIR:-/var/lib/pxe}"

  if [[ ! -d "$PXE_DIR" ]]; then
    echo "Error: $PXE_DIR doesn't exist — must run on the PXE boot server (stone)." >&2
    echo "       (services.pxeBootServer creates it; set PXE_DIR to override.)" >&2
    exit 1
  fi

  echo "Building thin netboot image for server..."
  NB="$SCRIPT_DIR#nixosConfigurations.server-netboot.config.system.build"
  kernel=$(nix build --no-link --print-out-paths --impure "$NB.kernel")
  initrd=$(nix build --no-link --print-out-paths --impure "$NB.netbootRamdisk")
  ipxe=$(nix build --no-link --print-out-paths --impure "$NB.netbootIpxeScript")
  toplevel=$(nix build --no-link --print-out-paths --impure \
    "$SCRIPT_DIR#nixosConfigurations.server.config.system.build.toplevel")

  echo "Staging boot files into $PXE_DIR..."
  install -m 0644 "$kernel/bzImage" "$PXE_DIR/bzImage"
  install -m 0644 "$initrd/initrd" "$PXE_DIR/initrd"
  install -m 0644 "$ipxe/netboot.ipxe" "$PXE_DIR/netboot.ipxe"

  echo "Copying target closure into $PXE_DIR/cache..."
  nix copy --to "file://$PXE_DIR/cache?compression=zstd" "$toplevel"

  echo ""
  echo "PXE server ready. Serving from $PXE_DIR"
  echo "Boxes will chain http://<stone>:8080/netboot.ipxe and pull closure at install time."
  echo "Press Ctrl+C when done netbooting."
  echo ""

  trap - EXIT
  while true; do sleep 1; done
}

case "$COMMAND" in
  build)
    case "$FLAG" in
      "") build_config ;;
      --sdimage) build_sdimage ;;
      --serve-pxe) serve_pxe ;;
    esac
    ;;
  switch)
    if [[ -n "$FLAG" ]]; then
      echo "Error: switch does not support flags" >&2
      exit 1
    fi
    switch_config
    ;;
esac

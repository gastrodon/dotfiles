#!/usr/bin/env bash
set -euo pipefail

export NIXPKGS_ALLOW_UNFREE=1
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Nix's git+ssh fetcher offers every ssh-agent key; isolate to the primary one.
# If we can't unlock it here (e.g. no TTY for the passphrase prompt), fall back
# to the caller's existing agent rather than leaving an empty one active.
if [[ -f "$HOME/.ssh/id_ed25519" ]]; then
  ORIGINAL_SSH_AUTH_SOCK="${SSH_AUTH_SOCK:-}"
  eval "$(ssh-agent -s)" >/dev/null
  trap 'ssh-agent -k >/dev/null 2>&1 || true' EXIT
  if ! ssh-add -q "$HOME/.ssh/id_ed25519" </dev/null >/dev/null 2>&1; then
    ssh-agent -k >/dev/null 2>&1 || true
    trap - EXIT
    export SSH_AUTH_SOCK="$ORIGINAL_SSH_AUTH_SOCK"
  fi
fi

usage() {
  cat >&2 <<EOF
Usage: $0 <build|switch> [hostname] [options]

Commands:
  build              Build configuration
  switch             Switch to new configuration + restart i3

Options:
  --sdimage          Build SD card image (rpi* only)
  --serve-pxe        Build + serve netboot (server only; foreground)
  --target HOST      Remote SSH target (repeatable; if specified, build for remotes)

Examples:
  $0 build stone
  $0 build stone --target root@192.168.1.10
  $0 build stone --target root@host1 --target root@host2
  $0 build rpi4b --sdimage
  $0 build server --serve-pxe
  $0 switch twink
  $0 switch twink --target root@192.168.1.10
EOF
  exit 1
}

[[ $# -lt 1 ]] && usage

COMMAND="$1"
HOSTNAME="${2:-${NIXOS_HOSTNAME:-$(hostname)}}"
shift 2 || shift $#

declare -a TARGET_HOSTS=()
FLAG=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --target)
      [[ -z "$2" ]] && { echo "Error: --target requires an argument" >&2; exit 1; }
      TARGET_HOSTS+=("$2")
      shift 2
      ;;
    --sdimage|--serve-pxe)
      [[ -n "$FLAG" ]] && { echo "Error: only one flag allowed (--sdimage or --serve-pxe)" >&2; exit 1; }
      FLAG="$1"
      shift
      ;;
    *)
      echo "Error: unknown option '$1'" >&2
      usage
      ;;
  esac
done

case "$COMMAND" in
  build|switch) ;;
  *) usage ;;
esac

# Run a nixos-rebuild subcommand across all targets, continuing past per-target
# failures (e.g. switch-to-configuration exits 4 when a remote box with a live
# desktop session can't reload user units — system switch still lands) so one
# bad host doesn't block the rest. Prints a summary and exits nonzero overall
# if any target failed.
run_multi_target() {
  local subcmd="$1"
  local -a failed=()
  echo "Running '$subcmd' for $HOSTNAME on ${#TARGET_HOSTS[@]} target(s)..."
  for target in "${TARGET_HOSTS[@]}"; do
    echo "  → $target"
    if ! nixos-rebuild "$subcmd" --flake "$SCRIPT_DIR#$HOSTNAME" --impure --target-host "$target"; then
      echo "  ✗ $target failed" >&2
      failed+=("$target")
    fi
  done
  if [[ ${#failed[@]} -gt 0 ]]; then
    echo "Failed targets: ${failed[*]}" >&2
    return 1
  fi
}

build_config() {
  if [[ ${#TARGET_HOSTS[@]} -gt 0 ]]; then
    run_multi_target build
  else
    echo "Building configuration for $HOSTNAME..."
    nixos-rebuild build --flake "$SCRIPT_DIR#$HOSTNAME" --impure
  fi
}

switch_config() {
  if [[ ${#TARGET_HOSTS[@]} -gt 0 ]]; then
    run_multi_target switch
  else
    echo "Switching to configuration for $HOSTNAME..."
    nixos-rebuild switch --flake "$SCRIPT_DIR#$HOSTNAME" --impure
    i3-msg restart 2>/dev/null || true
  fi
}

build_sdimage() {
  if [[ "$HOSTNAME" != "rpi2b" && "$HOSTNAME" != "rpi3b-plus" && "$HOSTNAME" != "rpi4b" ]]; then
    echo "Error: --sdimage only supported for rpi2b|rpi3b-plus|rpi4b" >&2
    exit 1
  fi
  echo "Building SD image for $HOSTNAME..."
  nix build "$SCRIPT_DIR#nixosConfigurations.${HOSTNAME}.config.system.build.sdImage" --impure
  echo "SD image at: $(readlink result)/sd-image/"
}

serve_pxe() {
  if [[ "$HOSTNAME" != "server" ]]; then
    echo "Error: --serve-pxe only supported for server" >&2
    exit 1
  fi

  PXE_DIR="${PXE_DIR:-/var/lib/pxe}"

  if [[ ! -d "$PXE_DIR" ]]; then
    echo "Error: $PXE_DIR doesn't exist — must run on the PXE boot server (stone)." >&2
    echo "       (services.pxeBootServer creates it; set PXE_DIR to override.)" >&2
    exit 1
  fi

  echo "Building thin netboot image for server..."
  NB="$SCRIPT_DIR#nixosConfigurations.server-netboot.config.system.build"
  kernel=$(nix build --no-link --print-out-paths --impure "$NB.kernel")
  initrd=$(nix build --no-link --print-out-paths --impure "$NB.netbootRamdisk")
  ipxe=$(nix build --no-link --print-out-paths --impure "$NB.netbootIpxeScript")
  toplevel=$(nix build --no-link --print-out-paths --impure \
    "$SCRIPT_DIR#nixosConfigurations.server.config.system.build.toplevel")

  echo "Staging boot files into $PXE_DIR..."
  install -m 0644 "$kernel/bzImage" "$PXE_DIR/bzImage"
  install -m 0644 "$initrd/initrd" "$PXE_DIR/initrd"
  install -m 0644 "$ipxe/netboot.ipxe" "$PXE_DIR/netboot.ipxe"

  echo "Copying target closure into $PXE_DIR/cache..."
  nix copy --to "file://$PXE_DIR/cache?compression=zstd" "$toplevel"

  echo ""
  echo "PXE server ready. Serving from $PXE_DIR"
  echo "Boxes will chain http://<stone>:8080/netboot.ipxe and pull closure at install time."
  echo "Press Ctrl+C when done netbooting."
  echo ""

  trap - EXIT
  while true; do sleep 1; done
}

case "$COMMAND" in
  build)
    case "$FLAG" in
      "")
        if [[ ${#TARGET_HOSTS[@]} -gt 0 ]]; then
          build_config
        else
          build_config
        fi
        ;;
      --sdimage)
        [[ ${#TARGET_HOSTS[@]} -gt 0 ]] && { echo "Error: --sdimage does not support --target" >&2; exit 1; }
        build_sdimage
        ;;
      --serve-pxe)
        [[ ${#TARGET_HOSTS[@]} -gt 0 ]] && { echo "Error: --serve-pxe does not support --target" >&2; exit 1; }
        serve_pxe
        ;;
    esac
    ;;
  switch)
    if [[ -n "$FLAG" ]]; then
      echo "Error: switch does not support --sdimage or --serve-pxe" >&2
      exit 1
    fi
    switch_config
    ;;
esac
